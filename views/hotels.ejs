<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root{--sand:#f5ede0;--clay:#c9794a;--earth:#6b4226;--deep:#1a1008;--sky:#3a7ca5;--leaf:#4a7c59;--gold:#e8a838;--white:#fdfaf5;--card-bg:rgba(255,255,255,0.92);--shadow:0 8px 32px rgba(26,16,8,0.13);--radius:18px;--font-head:'Playfair Display',serif;--font-body:'DM Sans',sans-serif;}
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:var(--font-body);background:var(--sand);color:var(--deep);min-height:100vh;}
  nav{position:sticky;top:0;z-index:1000;background:rgba(26,16,8,0.96);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:68px;box-shadow:0 2px 24px rgba(0,0,0,0.25);}
   .nav-logo{font-family:var(--font-head);font-size:1.6rem;font-weight:900;color:var(--gold);text-decoration:none;display:flex;align-items:center;gap:8px;}
  .nav-logo img{height:120px;width:auto;display:block;}
  .nav-logo span{color:var(--sand);font-weight:400;font-size:1.1rem;}
  .nav-links{display:flex;align-items:center;gap:6px;}
  .nav-links a{color:var(--sand);font-size:0.92rem;font-weight:500;text-decoration:none;padding:7px 16px;border-radius:50px;transition:background 0.2s;}
  .nav-links a:hover,.nav-links a.active{background:var(--clay);color:#fff;}
  .nav-btn{background:var(--gold)!important;color:var(--deep)!important;font-weight:700!important;border-radius:50px!important;padding:8px 22px!important;}
  .page-hero{background:linear-gradient(135deg,#1a1008,#3a2010 60%,#6b4226);padding:48px 24px 56px;text-align:center;}
  .page-hero h1{font-family:var(--font-head);font-size:clamp(2rem,5vw,3.2rem);color:#fdfaf5;font-weight:900;margin-bottom:10px;}
  .page-hero p{color:rgba(245,237,224,0.7);font-size:1rem;}
  .page-wrap{max-width:1100px;margin:0 auto;padding:48px 20px 80px;}
  .card{background:var(--card-bg);border-radius:var(--radius);box-shadow:var(--shadow);padding:28px;margin-bottom:24px;}
  .card-title{font-family:var(--font-head);font-size:1.2rem;font-weight:700;margin-bottom:14px;color:var(--earth);}
  input{font-family:var(--font-body);font-size:0.93rem;border:1.5px solid #e0d0bc;border-radius:10px;padding:10px 14px;outline:none;width:100%;background:var(--white);color:var(--deep);transition:border-color 0.2s;}
  input:focus{border-color:var(--clay);}
  .btn{display:inline-flex;align-items:center;gap:6px;background:var(--clay);color:#fff;padding:10px 22px;border-radius:50px;border:none;font-family:var(--font-body);font-size:0.93rem;font-weight:600;cursor:pointer;transition:background 0.2s,transform 0.15s;}
  .btn:hover{background:var(--earth);transform:translateY(-2px);}
  .row{display:flex;gap:16px;flex-wrap:wrap;}.row>*{flex:1 1 180px;}
  label{font-size:0.82rem;font-weight:600;color:#7a5a3a;display:block;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px;}
  .hotels-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;margin-top:20px;}
  .hotel-card{background:var(--white);border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(26,16,8,0.1);transition:transform 0.2s,box-shadow 0.2s;}
  .hotel-card:hover{transform:translateY(-4px);box-shadow:0 8px 32px rgba(26,16,8,0.15);}
  .hotel-img{width:100%;height:180px;object-fit:cover;background:linear-gradient(135deg,#c9794a,#6b4226);}
  .hotel-img-placeholder{width:100%;height:180px;background:linear-gradient(135deg,#c9794a,#6b4226);display:flex;align-items:center;justify-content:center;font-size:3rem;}
  .hotel-body{padding:16px;}
  .hotel-name{font-family:var(--font-head);font-size:1rem;font-weight:700;color:var(--earth);margin-bottom:4px;}
  .hotel-address{font-size:0.78rem;color:#a08060;margin-bottom:8px;}
  .hotel-rating{display:flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:600;color:var(--gold);}
  .hotel-price{font-family:var(--font-head);font-size:1.3rem;font-weight:900;color:var(--clay);margin-top:8px;}
  .hotel-stars{color:var(--gold);}
  .empty-state{text-align:center;padding:40px 20px;color:#a08060;}
  .loading{text-align:center;padding:40px;color:var(--clay);font-size:1rem;}
  footer{background:var(--deep);color:rgba(245,237,224,0.6);text-align:center;padding:28px 20px;font-size:0.82rem;}
  footer strong{color:var(--gold);}
  @media(max-width:768px){nav{padding:0 18px;}.nav-links{display:none;}.row{flex-direction:column;}.hotels-grid{grid-template-columns:1fr;}}

  .nav-dropdown{position:relative;}
  .nav-dropdown-menu{display:none;position:absolute;top:54px;right:0;background:rgba(26,16,8,0.98);border-radius:12px;padding:8px;min-width:180px;box-shadow:0 8px 24px rgba(0,0,0,0.3);z-index:2000;border:1px solid rgba(255,255,255,0.1);}
  .nav-dropdown-menu.open{display:block;animation:fadeDown 0.2s ease both;}
  @keyframes fadeDown{from{opacity:0;transform:translateY(-8px);}to{opacity:1;transform:translateY(0);}}
  .nav-dropdown-menu a{display:flex;align-items:center;gap:8px;color:var(--sand);text-decoration:none;padding:10px 14px;border-radius:8px;font-size:0.88rem;transition:background 0.2s;}
  .nav-dropdown-menu a:hover{background:var(--clay);}
  .nav-dropdown-menu .logout{color:#ff8080;}
  .nav-dropdown-menu .logout:hover{background:#c0392b;color:#fff;}
  .nav-dropdown-menu hr{border:none;border-top:1px solid rgba(255,255,255,0.1);margin:4px 0;}

</style>
</head>
<body>
<nav>
  <a class="nav-logo" href="/"><img src="/images/way-wiselogo.png" alt="Waywise"> <span></span></a>
  <div class="nav-links">
    <a href="/">Home</a>
    <a href="/budget">Budget</a>
    <a href="/itinerary">Itinerary</a>
    <a href="/weather">Weather</a>
    <a href="/hotels" class="active">Hotels</a>
    <% if (isLoggedIn) { %>
      <div class="nav-dropdown" id="nav-dropdown">
        <div class="nav-user" onclick="toggleDropdown()" style="cursor:pointer;display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:50px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);transition:background 0.2s;">
          <div style="width:32px;height:32px;border-radius:50%;background:var(--clay);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;">
            <%= currentUser.charAt(0).toUpperCase() %>
          </div>
          <span style="color:var(--sand);font-size:0.88rem;font-weight:600;"><%= currentUser.split(" ")[0] %></span>
          <span style="color:var(--sand);font-size:0.7rem;opacity:0.7;">&#9660;</span>
        </div>
        <div class="nav-dropdown-menu" id="nav-dropdown-menu">
          <a href="/auth/profile">&#128100; My Profile</a>
          <% if (currentRole === "admin") { %>
            <a href="/admin">&#9881;&#65039; Admin Panel</a>
          <% } %>
          <hr/>
          <a href="/auth/logout" class="logout">&#128682; Logout</a>
        </div>
      </div>
    <% } else { %>
      <a href="/auth/login" class="nav-btn">Login / Signup</a>
    <% } %>
  </div>
</nav>

<div class="page-hero">
  <h1>🏨 Find Hotels</h1>
  <p>Search the best hotels at your destination</p>
</div>

<div class="page-wrap">
  <div class="card">
    <div class="card-title">🔍 Search Hotels</div>
    <div class="row">
      <div><label>City / Destination</label><input id="hotel-city" type="text" placeholder="e.g. Paris, Goa, Tokyo" onkeydown="if(event.key==='Enter')searchHotels()"/></div>
      <div><label>Check-in</label><input id="hotel-checkin" type="date"/></div>
      <div><label>Check-out</label><input id="hotel-checkout" type="date"/></div>
      <div><label>Adults</label><input id="hotel-adults" type="number" value="2" min="1" max="10"/></div>
    </div>
    <button class="btn" style="margin-top:16px;" onclick="searchHotels()">🔍 Search Hotels</button>
  </div>

  <div id="hotels-result">
    <div class="empty-state">
      <div style="font-size:3rem;margin-bottom:12px;">🏨</div>
      <p>Search for a destination to see available hotels</p>
      <p style="font-size:0.82rem;margin-top:8px;color:#c0a080;">Powered by Booking.com via RapidAPI</p>
    </div>
  </div>
</div>

<footer>Made with ❤️ by <strong>Waywise</strong></footer>

<script>
// Set default dates
const today = new Date();
const tomorrow = new Date(today);
tomorrow.setDate(tomorrow.getDate() + 1);
const dayAfter = new Date(today);
dayAfter.setDate(dayAfter.getDate() + 2);
document.getElementById('hotel-checkin').value = tomorrow.toISOString().split('T')[0];
document.getElementById('hotel-checkout').value = dayAfter.toISOString().split('T')[0];

function searchHotels() {
  const city = document.getElementById('hotel-city').value.trim();
  const checkin = document.getElementById('hotel-checkin').value;
  const checkout = document.getElementById('hotel-checkout').value;
  const adults = document.getElementById('hotel-adults').value || 2;
  if (!city) { alert('Please enter a city!'); return; }

  const result = document.getElementById('hotels-result');

  // Popular hotel chains with direct booking links
  const hotelChains = [
    { name: 'Booking.com', icon: '🏨', color: '#003580', desc: 'Best prices guaranteed', url: `https://www.booking.com/searchresults.html?ss=${encodeURIComponent(city)}&checkin=${checkin}&checkout=${checkout}&group_adults=${adults}&no_rooms=1` },
    { name: 'MakeMyTrip', icon: '✈️', color: '#e8532b', desc: 'India\'s leading travel site', url: `https://www.makemytrip.com/hotels/hotel-listing/?checkin=${checkin}&checkout=${checkout}&city=${encodeURIComponent(city)}&adultsCount=${adults}` },
    { name: 'OYO Rooms', icon: '🛏️', color: '#ee2442', desc: 'Budget & premium stays', url: `https://www.oyorooms.com/search?location=${encodeURIComponent(city)}&checkInDate=${checkin}&checkOutDate=${checkout}&adultsCount=${adults}` },
    { name: 'Agoda', icon: '🌏', color: '#005eb8', desc: 'Great Asian hotel deals', url: `https://www.agoda.com/search?city=${encodeURIComponent(city)}&checkIn=${checkin}&checkOut=${checkout}&adults=${adults}` },
    { name: 'Goibibo', icon: '🏩', color: '#e8532b', desc: 'Top Indian hotels', url: `https://www.goibibo.com/hotels/hotels-in-${encodeURIComponent(city.toLowerCase())}/` },
    { name: 'Treebo Hotels', icon: '🌿', color: '#2db84b', desc: 'Quality budget hotels', url: `https://www.treebohotels.com/hotels-in-${encodeURIComponent(city.toLowerCase())}/` },
  ];

  result.innerHTML = `
    <div style="margin-bottom:20px;">
      <div style="font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:700;color:var(--earth);margin-bottom:6px;">
        🏨 Hotels in ${city}
      </div>
      <div style="font-size:0.88rem;color:#a08060;">
        Check-in: <strong>${checkin}</strong> · Check-out: <strong>${checkout}</strong> · Adults: <strong>${adults}</strong>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
      ${hotelChains.map(h => `
        <a href="${h.url}" target="_blank" style="text-decoration:none;">
          <div style="background:var(--white);border-radius:16px;padding:24px;box-shadow:0 4px 20px rgba(26,16,8,0.1);transition:transform 0.2s,box-shadow 0.2s;cursor:pointer;border-left:4px solid ${h.color};"
               onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 32px rgba(26,16,8,0.15)'"
               onmouseout="this.style.transform='none';this.style.boxShadow='0 4px 20px rgba(26,16,8,0.1)'">
            <div style="font-size:2rem;margin-bottom:10px;">${h.icon}</div>
            <div style="font-weight:700;font-size:1.05rem;color:var(--deep);margin-bottom:4px;">${h.name}</div>
            <div style="font-size:0.82rem;color:#a08060;margin-bottom:14px;">${h.desc}</div>
            <div style="display:inline-flex;align-items:center;gap:6px;background:${h.color};color:#fff;padding:8px 18px;border-radius:50px;font-size:0.85rem;font-weight:700;">
              Search Hotels →
            </div>
          </div>
        </a>
      `).join('')}
    </div>
    <div style="margin-top:20px;background:#fef3d0;border-radius:12px;padding:14px 18px;font-size:0.85rem;color:#7a5a00;">
      💡 <strong>Tip:</strong> Click any platform above to see real-time prices and availability for ${city}. All links are pre-filled with your dates!
    </div>
  `;
}

// ── PROFILE DROPDOWN ──
function toggleDropdown() {
  const menu = document.getElementById('nav-dropdown-menu');
  if (menu) menu.classList.toggle('open');
}
document.addEventListener('click', (e) => {
  const dropdown = document.getElementById('nav-dropdown');
  const menu = document.getElementById('nav-dropdown-menu');
  if (menu && dropdown && !dropdown.contains(e.target)) {
    menu.classList.remove('open');
  }
});

</script>
</body>
</html>
