<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
  :root{--sand:#f5ede0;--clay:#c9794a;--earth:#6b4226;--deep:#1a1008;--gold:#e8a838;--white:#fdfaf5;--font-head:'Playfair Display',serif;--font-body:'DM Sans',sans-serif;}
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:var(--font-body);background:linear-gradient(135deg,#1a1008,#3a2010 50%,#6b4226);min-height:100vh;display:flex;flex-direction:column;}
  nav{background:rgba(26,16,8,0.96);display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:68px;}
  .nav-logo{font-family:var(--font-head);font-size:1.6rem;font-weight:900;color:var(--gold);text-decoration:none;}
  .nav-logo span{color:var(--sand);font-weight:400;font-size:1.1rem;}
  .auth-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 20px;}
  .auth-card{background:rgba(255,255,255,0.96);border-radius:20px;box-shadow:0 8px 40px rgba(26,16,8,0.18);width:100%;max-width:460px;overflow:hidden;animation:slideUp 0.4s ease both;}
  @keyframes slideUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
  .auth-header{background:linear-gradient(135deg,var(--earth),var(--clay));padding:28px 32px;text-align:center;}
  .auth-header h1{font-family:var(--font-head);color:#fff;font-size:1.8rem;font-weight:900;margin-bottom:4px;}
  .auth-header p{color:rgba(245,237,224,0.8);font-size:0.88rem;}
  .auth-body{padding:32px;}
  .field{margin-bottom:18px;}
  .field label{font-size:0.78rem;font-weight:700;color:#7a5a3a;display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:0.5px;}
  .field input{width:100%;padding:11px 14px;border:1.5px solid #e0d0bc;border-radius:12px;font-family:var(--font-body);font-size:0.93rem;background:var(--white);color:var(--deep);outline:none;transition:border-color 0.2s;}
  .field input:focus{border-color:var(--clay);box-shadow:0 0 0 3px rgba(201,121,74,0.12);}
  .auth-btn{width:100%;padding:13px;border:none;border-radius:50px;background:var(--clay);color:#fff;font-family:var(--font-body);font-size:1rem;font-weight:700;cursor:pointer;transition:background 0.2s,transform 0.15s;margin-top:6px;}
  .auth-btn:hover{background:var(--earth);transform:translateY(-2px);}
  .error-box{background:#fde8e8;border:1px solid #f0c0c0;border-radius:10px;padding:10px 14px;margin-bottom:16px;color:#c0392b;font-size:0.88rem;}
  .auth-footer{text-align:center;margin-top:20px;font-size:0.88rem;color:#7a5a3a;}
  .auth-footer a{color:var(--clay);font-weight:700;text-decoration:none;}
  .auth-footer a:hover{text-decoration:underline;}
</style>
</head>
<body>
<nav>
  <a class="nav-logo" href="/">🌍 Waywise <span>Travel</span></a>
</nav>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-header">
      <h1>Welcome Back!</h1>
      <p>Sign in to your Waywise account</p>
    </div>
    <div class="auth-body">
      <% if (error) { %>
        <div class="error-box">⚠️ <%= error %></div>
      <% } %>
      <form method="POST" action="/auth/login">
        <div class="field">
          <label>Email Address</label>
          <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"/>
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" name="password" placeholder="Your password" required autocomplete="current-password"/>
        </div>
        <button type="submit" class="auth-btn">🔐 Sign In</button>
      </form>
      <div class="auth-footer">
        Don't have an account? <a href="/auth/signup">Sign up free →</a>
      </div>
    </div>
  </div>
</div>
</body>
</html>
