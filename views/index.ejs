<script>
// ── PROFILE DROPDOWN ──
function toggleDropdown() {
  const menu = document.getElementById('nav-dropdown-menu');
  if (menu) menu.classList.toggle('open');
}
// Close dropdown when clicking outside
document.addEventListener('click', (e) => {
  const dropdown = document.getElementById('nav-dropdown');
  const menu = document.getElementById('nav-dropdown-menu');
  if (menu && dropdown && !dropdown.contains(e.target)) {
    menu.classList.remove('open');
  }
});

// ── MOBILE NAV ──
function toggleMobile(){
  const m=document.getElementById('mobile-menu'),h=document.getElementById('hamburger'),o=document.getElementById('menu-overlay');
  if(m.classList.contains('open')){closeMobile();return;}
  m.classList.add('open');h.classList.add('open');o.classList.add('open');
  document.body.style.overflow='hidden';
}
function closeMobile(){
  document.getElementById('mobile-menu').classList.remove('open');
  document.getElementById('hamburger').classList.remove('open');
  document.getElementById('menu-overlay').classList.remove('open');
  document.body.style.overflow='';
}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMobile();});

// ── QUICK WEATHER (calls our own server API now — no exposed key) ──
async function quickWeather(){
  const city=document.getElementById('home-weather-input').value.trim();
  if(!city)return;
  const el=document.getElementById('home-weather-result');
  el.innerHTML='<div style="color:rgba(255,255,255,0.75);font-size:0.9rem;">⏳ Loading…</div>';
  try{
    // Calls our own /api/weather route (key stays on server)
    const res=await fetch(`/api/weather?city=${encodeURIComponent(city)}`);
    const data=await res.json();
    if(data.error)throw new Error(data.error);
    const icons={'Thunderstorm':'⛈️','Drizzle':'🌦️','Rain':'🌧️','Snow':'❄️','Clear':'☀️','Clouds':'⛅','Mist':'🌫️','Fog':'🌫️','Haze':'🌫️'};
    const icon=icons[data.weather[0].main]||'🌤️';
    el.innerHTML=`<div style="display:inline-flex;gap:14px;align-items:center;background:rgba(255,255,255,0.12);border-radius:16px;padding:16px 24px;flex-wrap:wrap;justify-content:center;margin-top:4px;">
      <span style="font-size:2rem;">${icon}</span>
      <div style="text-align:left;"><div style="font-weight:700;color:#fff;font-size:1rem;">${data.name}, ${data.sys.country}</div>
      <div style="color:rgba(255,255,255,0.8);font-size:0.85rem;text-transform:capitalize;">${data.weather[0].description}</div></div>
      <div style="font-family:'Playfair Display',serif;font-size:2.4rem;font-weight:900;color:#e8a838;">${Math.round(data.main.temp)}°C</div>
      <div style="font-size:0.78rem;color:rgba(255,255,255,0.6);">💧 ${data.main.humidity}% &nbsp; 💨 ${data.wind.speed}m/s</div>
      <a href="/weather" style="background:#e8a838;color:#1a1008;border:none;border-radius:50px;padding:7px 16px;font-weight:700;cursor:pointer;font-size:0.8rem;text-decoration:none;">Full Forecast →</a>
    </div>`;
  }catch(e){
    el.innerHTML='<div style="color:#ffaaaa;font-size:0.9rem;">❌ City not found</div>';
  }
}
</script>
