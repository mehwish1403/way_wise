<!-- ========== INDEPENDENT TRIP CAROUSEL SECTION - 15 INDIAN DESTINATIONS ========== -->


<script>
  (function() {
    const track = document.getElementById('indiaCarouselTrack');
    const prevBtn = document.getElementById('indiaPrevBtn');
    const nextBtn = document.getElementById('indiaNextBtn');
    const dotsContainer = document.getElementById('indiaDotsContainer');
    const slides = document.querySelectorAll('.carousel-slide');
    const totalSlides = slides.length;  // 15 Indian places
    
    let currentIndex = 0;
    let autoSlideInterval;
    let isDragging = false;
    let startX = 0;
    let dragStartTransform = 0;
    let currentTranslate = 0;
    
    // Create dots
    function createDots() {
      dotsContainer.innerHTML = '';
      for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('div');
        dot.classList.add('india-dot');
        dot.setAttribute('data-idx', i);
        dot.style.width = '10px';
        dot.style.height = '10px';
        dot.style.background = '#cbd5e1';
        dot.style.borderRadius = '20px';
        dot.style.transition = 'all 0.2s';
        dot.style.cursor = 'pointer';
        dot.style.margin = '0 4px';
        dot.addEventListener('click', () => {
          stopAutoSlide();
          currentIndex = i;
          setSliderPosition(true);
          startAutoSlide();
        });
        dotsContainer.appendChild(dot);
      }
      updateDotsActive();
    }
    
    function updateDotsActive() {
      const allDots = document.querySelectorAll('.india-dot');
      allDots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.style.background = '#bf5e1f';
          dot.style.width = '28px';
        } else {
          dot.style.background = '#cbd5e1';
          dot.style.width = '10px';
        }
      });
    }
    
    function setSliderPosition(animate = true) {
      if (!track) return;
      const containerWidth = track.parentElement.clientWidth;
      const newTranslate = -currentIndex * containerWidth;
      currentTranslate = newTranslate;
      if (animate) {
        track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      } else {
        track.style.transition = 'none';
      }
      track.style.transform = `translateX(${newTranslate}px)`;
      updateDotsActive();
    }
    
    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      setSliderPosition(true);
    }
    
    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      setSliderPosition(true);
    }
    
    // Auto slide every 4 seconds
    function startAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
      autoSlideInterval = setInterval(() => {
        nextSlide();
      }, 4000);
    }
    
    function stopAutoSlide() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = null;
      }
    }
    
    // Event listeners
    if (prevBtn) prevBtn.addEventListener('click', () => { stopAutoSlide(); prevSlide(); startAutoSlide(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { stopAutoSlide(); nextSlide(); startAutoSlide(); });
    
    // Swipe (touch & mouse) support
    function onDragStart(e) {
      if (!track) return;
      stopAutoSlide();
      isDragging = true;
      startX = e.type === 'touchstart' ? e.touches[0].clientX : e.clientX;
      const containerWidth = track.parentElement.clientWidth;
      dragStartTransform = -currentIndex * containerWidth;
      track.style.transition = 'none';
      track.style.cursor = 'grabbing';
      e.preventDefault();
    }
    
    function onDragMove(e) {
      if (!isDragging || !track) return;
      const currentX = e.type === 'touchmove' ? e.touches[0].clientX : e.clientX;
      const diffX = currentX - startX;
      let newTranslate = dragStartTransform + diffX;
      const containerWidth = track.parentElement.clientWidth;
      const maxEdge = 0;
      const minEdge = -(totalSlides - 1) * containerWidth;
      if (newTranslate > maxEdge) newTranslate = maxEdge + (newTranslate - maxEdge) * 0.3;
      if (newTranslate < minEdge) newTranslate = minEdge + (newTranslate - minEdge) * 0.3;
      track.style.transform = `translateX(${newTranslate}px)`;
      currentTranslate = newTranslate;
    }
    
    function onDragEnd(e) {
      if (!isDragging || !track) { isDragging = false; return; }
      isDragging = false;
      track.style.cursor = 'grab';
      const containerWidth = track.parentElement.clientWidth;
      const expectedIndex = Math.round(-currentTranslate / containerWidth);
      let newIndex = Math.min(Math.max(expectedIndex, 0), totalSlides - 1);
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        setSliderPosition(true);
      } else {
        setSliderPosition(true);
      }
      startAutoSlide();
    }
    
    if (track) {
      track.style.cursor = 'grab';
      track.addEventListener('mousedown', onDragStart);
      window.addEventListener('mousemove', onDragMove);
      window.addEventListener('mouseup', onDragEnd);
      track.addEventListener('touchstart', onDragStart, { passive: false });
      track.addEventListener('touchmove', onDragMove, { passive: false });
      track.addEventListener('touchend', onDragEnd);
      track.addEventListener('dragstart', (e) => e.preventDefault());
    }
    
    // Resize handler
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (track) {
          const containerWidth = track.parentElement.clientWidth;
          currentTranslate = -currentIndex * containerWidth;
          track.style.transition = 'none';
          track.style.transform = `translateX(${currentTranslate}px)`;
          setTimeout(() => { if (track) track.style.transition = 'transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94)'; }, 50);
        }
      }, 100);
    });
    
    // Initialize
    createDots();
    setSliderPosition(false);
    startAutoSlide();
    
    // hover effect arrows
    [prevBtn, nextBtn].forEach(btn => {
      if(btn) btn.addEventListener('mouseenter', () => btn.style.background = '#a0521a');
      if(btn) btn.addEventListener('mouseleave', () => btn.style.background = 'rgba(191,94,31,0.85)');
    });
    
    // plan trip button alerts (just for demo)
    document.querySelectorAll('.plan-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        alert('✨ Start planning your Indian adventure! ✨');
      });
    });
  })();
</script>
